PREFIX :       <#>
PREFIX fuseki: <http://jena.apache.org/fuseki#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ja:     <http://jena.hpl.hp.com/2005/11/Assembler#>

## Generated by run_fuseki_tests.py: one dataset per Jena reasoner,
## each loading the test data into memory at start-up.

[] rdf:type fuseki:Server .

:base a ja:MemoryModel ;
    ja:content [ ja:externalContent <file:///Users/lgu/workspace/Others/JRC/reasoning/reasoning-capability-test/graphdb/data/university.ttl> ] .

## none: no reasoner (explicit triples only)
:svc_none a fuseki:Service ;
    fuseki:name "none" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:dataset :ds_none .
:ds_none a ja:RDFDataset ;
    ja:defaultGraph :base .

## transitive: subClassOf / subPropertyOf closure only
:svc_transitive a fuseki:Service ;
    fuseki:name "transitive" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:dataset :ds_transitive .
:ds_transitive a ja:RDFDataset ;
    ja:defaultGraph :inf_transitive .
:inf_transitive a ja:InfModel ;
    ja:baseModel :base ;
    ja:reasoner [ ja:reasonerURL <http://jena.hpl.hp.com/2003/TransitiveReasoner> ] .

## rdfs: RDFS rule reasoner
:svc_rdfs a fuseki:Service ;
    fuseki:name "rdfs" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:dataset :ds_rdfs .
:ds_rdfs a ja:RDFDataset ;
    ja:defaultGraph :inf_rdfs .
:inf_rdfs a ja:InfModel ;
    ja:baseModel :base ;
    ja:reasoner [ ja:reasonerURL <http://jena.hpl.hp.com/2003/RDFSExptRuleReasoner> ] .

## owl-micro: RDFS + some OWL (inverse, transitive, symmetric, equivalence, intersection, hasValue)
:svc_owl_micro a fuseki:Service ;
    fuseki:name "owl-micro" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:dataset :ds_owl_micro .
:ds_owl_micro a ja:RDFDataset ;
    ja:defaultGraph :inf_owl_micro .
:inf_owl_micro a ja:InfModel ;
    ja:baseModel :base ;
    ja:reasoner [ ja:reasonerURL <http://jena.hpl.hp.com/2003/OWLMicroFBRuleReasoner> ] .

## owl-mini: OWL rules without bNode-creating rules (minCardinality, someValuesFrom)
:svc_owl_mini a fuseki:Service ;
    fuseki:name "owl-mini" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:dataset :ds_owl_mini .
:ds_owl_mini a ja:RDFDataset ;
    ja:defaultGraph :inf_owl_mini .
:inf_owl_mini a ja:InfModel ;
    ja:baseModel :base ;
    ja:reasoner [ ja:reasonerURL <http://jena.hpl.hp.com/2003/OWLMiniFBRuleReasoner> ] .

## owl: full Jena OWL rule set (OWL Lite + part of OWL DL)
:svc_owl a fuseki:Service ;
    fuseki:name "owl" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:dataset :ds_owl .
:ds_owl a ja:RDFDataset ;
    ja:defaultGraph :inf_owl .
:inf_owl a ja:InfModel ;
    ja:baseModel :base ;
    ja:reasoner [ ja:reasonerURL <http://jena.hpl.hp.com/2003/OWLFBRuleReasoner> ] .
